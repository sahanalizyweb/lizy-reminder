# Base URL of the Laravel API. Leave unset in development (Vite proxies /api to Laravel).
# For a production build hosted on another origin, e.g.:
# VITE_API_URL=https://reminder.example.com/api
VITE_API_URL=

# Where the Vite dev server forwards /api requests (default http://127.0.0.1:8000)
# VITE_PROXY_TARGET=http://127.0.0.1:8000
